+<script setup lang="ts">
+import { ref, watch } from 'vue';
+import type { ThemedToken } from 'shiki/core';
+import { useClipboard } from '@vueuse/core';
+import { Check, Copy } from '@lucide/vue';
+import { Button } from '@/components/ui/button';
+import { useAppearance } from '@/composables/useAppearance';
+const props = withDefaults(
+    defineProps<{ content: string; file?: string; startLine?: number }>(),
+    { file: '', startLine: 1 },
+);
+const { resolvedAppearance } = useAppearance();
+const { copy, copied, isSupported } = useClipboard();
+const tokens = ref<ThemedToken[][] | null>(null);
+watch(
+    () => [props.content, props.file, resolvedAppearance.value],
+    async (_, __, cleanup) => {
+        let cancelled = false;
+        cleanup(() => (cancelled = true));
+        tokens.value = null;
+        try {
+            const { highlight } = await import('@/lib/highlight');
+            const result = await highlight(
+                props.content,
+                props.file,
+                resolvedAppearance.value === 'dark',
+            );
+            if (!cancelled) tokens.value = result;
+        } catch {
+            if (!cancelled) tokens.value = null;
+        }
+    },
+    { immediate: true },
+);
+</script>
+<template>
+    <div class="min-w-0 overflow-hidden rounded-lg border bg-muted/30">
+        <div
+            class="flex min-h-10 items-center justify-between gap-3 border-b px-3"
+        >
+            <span class="technical-value text-xs text-muted-foreground">{{
+                file || 'Evidence excerpt'
+            }}</span
+            ><Button
+                v-if="isSupported"
+                variant="ghost"
+                size="icon"
+                :aria-label="copied ? 'Copied' : 'Copy code'"
+                @click="copy(content)"
+                ><Check v-if="copied" /><Copy v-else
+            /></Button>
+        </div>
+        <pre
+            tabindex="0"
+            :aria-label="file ? `Code from ${file}` : 'Evidence excerpt'"
+            class="max-h-96 overflow-auto py-3 font-mono text-xs leading-6"
+        ><code v-if="tokens"><span v-for="(line, i) in tokens" :key="i" class="block px-4"><span class="mr-5 inline-block min-w-6 text-right text-muted-foreground select-none" aria-hidden="true">{{ startLine + i }}</span><span v-for="(token, j) in line" :key="j" :style="{ color: token.color }">{{ token.content }}</span>{{ line.length ? '' : ' ' }}</span></code><code v-else class="block px-4">{{ content }}</code></pre>
+    </div>
+</template>

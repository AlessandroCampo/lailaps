+<?php
+
+namespace App\Services;
+
+use App\Http\Resources\AuditRunResource;
+use App\Models\AuditRun;
+use Illuminate\Http\Request;
+use Illuminate\Support\Arr;
+
+final class AuditRunPresenter
+{
+    public const array FINDING_STATUSES = ['confirmed', 'suspected', 'blocked', 'inconclusive'];
+
+    public function summary(AuditRun $run, Request $request): array
+    {
+        $summary = AuditRun::summary()->findOrFail($run->id);
+
+        return (new AuditRunResource($summary))->resolve($request);
+    }
+
+    public function snapshot(AuditRun $run, Request $request, bool $withDetails = true): array
+    {
+        $summary = $this->summary($run, $request);
+        $leads = $withDetails ? $run->leads()->where('is_current', true)
+            ->whereIn('status', [...self::FINDING_STATUSES, 'running'])
+            ->orderBy('created_at')->orderBy('id')->get() : collect();
+
+        return [
+            'run' => $summary,
+            'findings' => $leads->map(fn ($lead): array => [
+                'id' => $lead->id,
+                'title' => $lead->title,
+                'status' => $lead->status->value,
+                'severity' => $lead->severity,
+                'location' => data_get($lead->payload, 'locations.0.file'),
+            ])->values()->all(),
+            'activity' => $withDetails ? array_reverse($run->progress['activity'] ?? []) : [],
+        ];
+    }
+
+    public function report(AuditRun $run): array
+    {
+        $payload = $run->outcome ?? [];
+
+        return [
+            'findings' => $run->leads()->where('is_current', true)->whereIn('status', [...self::FINDING_STATUSES, 'running'])
+                ->orderBy('created_at')->orderBy('id')->get()->map(fn ($lead): array => [
+                    ...Arr::only($lead->payload ?? [], ['title', 'status', 'severity', 'confidence', 'description', 'conclusion', 'reason', 'recommendation', 'category', 'cwe_ids', 'locations']),

+<script setup lang="ts">
+import { computed } from 'vue';
+import { Check, LoaderCircle } from '@lucide/vue';
+import { Badge } from '@/components/ui/badge';
+import { labels } from '@/lib/scans';
+const props = defineProps<{
+    status: string;
+    finalizing?: boolean;
+    finding?: boolean;
+    interrupted?: boolean;
+}>();
+const variant = computed(() =>
+    props.finalizing || ['running', 'pending'].includes(props.status)
+        ? 'info'
+        : ['partial', 'suspected', 'blocked', 'inconclusive'].includes(
+                props.status,
+            )
+          ? 'warning'
+          : props.status === 'failed'
+            ? 'destructive'
+            : props.status === 'completed'
+              ? 'success'
+              : 'secondary',
+);
+</script>
+
+<template>
+    <Badge :variant="variant">
+        <LoaderCircle
+            v-if="(status === 'running' && !interrupted) || finalizing"
+            class="size-3 animate-spin"
+            aria-hidden="true"
+        />
+        <Check
+            v-else-if="status === 'confirmed' || status === 'completed'"
+            class="size-3"
+            aria-hidden="true"
+        />
+        {{
+            finalizing
+                ? 'Finalizing'
+                : finding && status === 'running'
+                  ? interrupted
+                      ? 'Unfinished'
+                      : 'Investigating'
+                  : labels[status] || status

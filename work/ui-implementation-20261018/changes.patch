+<script setup lang="ts">
+import { Head, Link, router } from '@inertiajs/vue3';
+import { computed, ref, watch } from 'vue';
+import { useNow } from '@vueuse/core';
+import { Circle, FileText } from '@lucide/vue';
+import { Button } from '@/components/ui/button';
+import { Card, CardContent } from '@/components/ui/card';
+import ScanStatus from '@/components/projects/ScanStatus.vue';
+import ScanCounts from '@/components/projects/ScanCounts.vue';
+import ScanBudget from '@/components/projects/ScanBudget.vue';
+import FindingList from '@/components/projects/FindingList.vue';
+import { useScanLive } from '@/composables/useScanLive';
+import { date, duration, elapsed } from '@/lib/scans';
+import { show as projectRoute } from '@/routes/projects';
+import { report as reportRoute } from '@/routes/projects/scans';
+import type { Project } from '@/types/project';
+import type { ScanSnapshot } from '@/types/scan';
+const props = defineProps<ScanSnapshot & { project: Project }>();
+const snapshot = ref<ScanSnapshot>({
+    run: props.run,
+    findings: props.findings,
+    activity: props.activity,
+});
+watch(
+    () => props.run,
+    () =>
+        (snapshot.value = {
+            run: props.run,
+            findings: props.findings,
+            activity: props.activity,
+        }),
+);
+const { connection } = useScanLive(
+    () => props.project.id,
+    () => snapshot.value.run,
+    (value) => (snapshot.value = value),
+);
+const run = computed(() => snapshot.value.run);
+const now = useNow({ interval: 1000 });
+const query =
+    typeof window !== 'undefined'
+        ? new URLSearchParams(window.location.search)
+        : new URLSearchParams();
+const tab = ref(
+    query.get('tab') === 'findings'
+        ? 'findings'
+        : query.get('tab') === 'activity' || props.run.active
+          ? 'activity'
+          : 'findings',
+);
+const filter = ref(query.get('status') || 'all');
+const search = ref(query.get('search') || '');
+watch([tab, filter, search], () => {
+    const url = new URL(window.location.href);
+    url.searchParams.set('tab', tab.value);
+    filter.value === 'all'
+        ? url.searchParams.delete('status')
+        : url.searchParams.set('status', filter.value);
+    search.value
+        ? url.searchParams.set('search', search.value)
+        : url.searchParams.delete('search');
+    router.replace({
+        url: `${url.pathname}${url.search}`,
+        props: (current) => ({ ...current, ...snapshot.value }),
+        preserveState: true,
+        preserveScroll: true,
+    });
+});
+</script>
+<template>
+    <Head :title="`Scan · ${project.name}`" />
+    <div class="page-container space-y-8">
+        <Link
+            :href="projectRoute(project.id)"
+            class="metadata hover:text-foreground"
+            >{{ project.name }} /
+            <span class="text-foreground">Scan</span></Link
+        >
+        <header class="flex flex-wrap items-start justify-between gap-4">

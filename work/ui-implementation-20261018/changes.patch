@@ -0,0 +1,59 @@
+import { onBeforeUnmount, ref, watch } from 'vue';
+import { events } from '@/routes/projects/scans';
+import type { Scan, ScanSnapshot } from '@/types/scan';
+
+export function useScanLive(
+    projectId: () => string,
+    run: () => Scan | null,
+    update: (snapshot: ScanSnapshot) => void,
+    summary = false,
+) {
+    const connection = ref<
+        'idle' | 'connecting' | 'connected' | 'reconnecting'
+    >('idle');
+    let stream: EventSource | null = null;
+    let errorTimer: ReturnType<typeof setTimeout> | undefined;
+
+    function close() {
+        stream?.close();
+        stream = null;
+        clearTimeout(errorTimer);
+    }
+
+    watch(
+        () => [run()?.id, run()?.active] as const,
+        ([id, active]) => {
+            close();
+            if (!id || !active || typeof window === 'undefined') {
+                connection.value = 'idle';
+                return;
+            }
+            connection.value = 'connecting';
+            stream = new EventSource(
+                events.url(
+                    { project: projectId(), run: id },
+                    { query: { summary } },
+                ),
+            );
+            stream.onopen = () => {
+                clearTimeout(errorTimer);
+                connection.value = 'connected';
+            };
+            stream.onmessage = (event) => {
+                clearTimeout(errorTimer);
+                connection.value = 'connected';
+                update(JSON.parse(event.data) as ScanSnapshot);
+            };
+            stream.onerror = () => {
+                clearTimeout(errorTimer);
+                errorTimer = setTimeout(() => {
+                    connection.value = 'reconnecting';
+                }, 2500);
+            };
+        },
+        { immediate: true },
+    );
+
+    onBeforeUnmount(close);
+    return { connection };
+}

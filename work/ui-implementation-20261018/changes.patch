+import type { Scan, Usage } from '@/types/scan';
+
+export const verdicts = [
+    'confirmed',
+    'suspected',
+    'blocked',
+    'inconclusive',
+] as const;
+export const labels: Record<string, string> = {
+    pending: 'Queued',
+    running: 'Running',
+    completed: 'Completed',
+    partial: 'Partial',
+    failed: 'Failed',
+    confirmed: 'Confirmed',
+    suspected: 'Suspected',
+    blocked: 'Blocked',
+    inconclusive: 'Inconclusive',
+};
+
+export function date(value: string | null, time = false): string {
+    return value
+        ? new Date(value).toLocaleString(
+              'en-US',
+              time
+                  ? { dateStyle: 'medium', timeStyle: 'short' }
+                  : { dateStyle: 'medium' },
+          )
+        : 'Not recorded';
+}
+
+export function duration(seconds: number | null): string {
+    if (seconds === null) return '—';
+    const value = Math.max(0, Math.floor(seconds));
+    const hours = Math.floor(value / 3600);
+    const minutes = Math.floor((value % 3600) / 60);
+    return `${hours ? `${hours}h ` : ''}${minutes}m ${value % 60}s`;
+}
+
+export function elapsed(run: Scan, now: Date): number | null {
+    return run.active && run.started_at
+        ? Math.max(
+              0,
+              (now.getTime() - new Date(run.started_at).getTime()) / 1000,
+          )
+        : run.duration_seconds;
+}
+
+export function budget(usage: Usage): number | null {
+    if (
+        typeof usage.points_used !== 'number' ||
+        typeof usage.point_limit !== 'number' ||
+        usage.point_limit <= 0
+    )
+        return null;
+    return Math.round((usage.points_used / usage.point_limit) * 100);
+}

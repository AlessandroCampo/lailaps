+        status = next((line.partition(":")[2].strip().casefold() for line in content.splitlines()[:20]
+                       if line.partition(":")[0].strip().casefold() == "result_status"), "")
+        if status == "validation_error":
+            return "validation_failures"
+        if status == "error":
+            return "execution_failures"
+        if status in {"ok", "success"}:
+            return "successes"
+        if content.lstrip().startswith("{"):
+            try:
+                parsed = json.loads(content)
+            except json.JSONDecodeError:
+                pass
+    if isinstance(parsed, dict) and (
+        parsed.get("ok") is False or parsed.get("timed_out") is True
+        or parsed.get("fatal") is True or parsed.get("is_error") is True
+        or parsed.get("status") in ("error", "unavailable", "backend_unavailable", "timeout", "query_failed")
+        or isinstance(parsed.get("error"), str) and bool(parsed["error"])
+    ):
+        return "execution_failures"
+    return "successes"

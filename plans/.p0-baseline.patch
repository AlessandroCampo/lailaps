+@pytest.mark.asyncio
+async def test_reader_serialized_prefix_and_large_tool_batch_are_stable(deps, monkeypatch):
+    from dataclasses import asdict
+    from functools import wraps
+    import threading
+    import time
+
+    active = peak = completed = 0
+    lock = threading.Lock()
+    original = triple_agent.read_file_window
+
+    @wraps(original)
+    def bounded(*args, **kwargs):
+        nonlocal active, peak, completed
+        with lock:
+            active += 1
+            peak = max(peak, active)
+        try:
+            time.sleep(0.001)
+            return original(*args, **kwargs)
+        finally:
+            with lock:
+                active -= 1
+                completed += 1
+
+    monkeypatch.setattr(triple_agent, "read_file_window", bounded)
+    state = triple_agent.ReaderConversationState(model_name="reader")
+    payloads = []
+
+    def respond(messages, info):
+        payloads.append(([asdict(t) for t in info.function_tools], [asdict(t) for t in info.output_tools], list(messages)))
+        if len(payloads) == 1:
+            return ModelResponse(parts=[ToolCallPart("read_file", {"path": "render.py", "start": 1, "count": 2}, tool_call_id=f"read-{i}") for i in range(128)])
+        output = (ReaderCheckpoint(decision="continue", reason="One branch remains.", next_step="Read the sibling helper.", checkpoint_summary="Rendering input was observed.")
+                  if state.checkpoint_mode else ReaderReviewRequested(reason="Rendering input was observed."))
+        tool = next(t for t in info.output_tools if type(output).__name__ in t.name)
+        return ModelResponse(parts=[ToolCallPart(tool.name, output.model_dump(mode="json"))])
+
+    monkeypatch.setattr(triple_agent, "make_model", lambda *_: FunctionModel(respond))
+    reader = make_reader("reader", deps, state)
+    result = await reader.run("Explore rendering.", deps=deps)
+    assert completed == 128
+    assert peak == 1
+    state.checkpoint_mode = True
+    # Changing the dossier must not rewrite the frozen system prompt.
+    deps.prior_context = "New observations belong in the appended checkpoint request."
+    checkpoint = make_reader_checkpoint("reader", deps, state)
+    checkpoint_result = await checkpoint.run("Checkpoint the observed work.", deps=deps, message_history=result.all_messages())
+    assert isinstance(checkpoint_result.output, ReaderCheckpoint)
+    assert payloads[0][:2] == payloads[-1][:2]
+    prior_parts = [part for message in result.all_messages() for part in message.parts]
+    checkpoint_parts = [part for message in payloads[-1][2] for part in message.parts]
+    assert checkpoint_parts[:len(prior_parts)] == prior_parts
+    assert completed == 128

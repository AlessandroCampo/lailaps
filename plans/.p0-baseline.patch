+    """Resolve the Reader's history window once for operations and checkpoints."""
+    budget = context_budget_from_settings(settings, role="reader")
+    provider_window = model_context_window_tokens(model, provider)
+    physical_window = min(budget.context_window, provider_window) if provider_window else budget.context_window

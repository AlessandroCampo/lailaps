+    requested = model_cognitive_window_tokens(model)
+    effective = min(requested, physical.history_capacity, prompt_cap)
+    clamp = (
+        "physical_context" if physical.history_capacity == effective and effective < requested
+        else "prompt_input_cap" if prompt_cap == effective and effective < requested
+        else None
+    )
+    return {
+        "requested_window_tokens": requested,
+        "effective_window_tokens": effective,
+        "soft_limit_tokens": int(effective * 0.75),
+        "hard_limit_tokens": int(effective * 0.90),
+        "physical_context_tokens": physical_window,
+        "max_prompt_input_tokens": int(getattr(settings, "max_prompt_input_tokens")),
+        "clamp_reason": clamp,
+    }
